# ── Discord credentials ──────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from the "General Information" page
CLIENT_ID=your-application-id-here

# Optional: register commands to a single guild for instant availability
# during development. Leave blank to register commands globally
# (global registration can take up to an hour to propagate).
GUILD_ID=

# ── librespot configuration ──────────────────────────────────────────
# Absolute path to the librespot binary on the Raspberry Pi.
LIBRESPOT_PATH=/usr/bin/librespot

# Name that appears in the Spotify Connect device list.
LIBRESPOT_DEVICE_NAME=DiscordBot

# Initial volume (0-100) passed to librespot.
LIBRESPOT_INITIAL_VOLUME=100

# ── Soundboard web server ────────────────────────────────────────────
# Set to false to run the bot without the soundboard API.
SOUNDBOARD_ENABLED=true

# Port the Express API + WebSocket listen on.
SOUNDBOARD_PORT=3000

# Exact origin of the deployed web app (CORS is pinned to this).
# e.g. https://kind-hill-01234.azurestaticapps.net
WEB_ORIGIN=

# Public HTTPS URL of this API through the tunnel (no trailing slash).
# Used to build the OAuth redirect URI: <PUBLIC_API_URL>/api/auth/callback
# e.g. https://api.example.com
PUBLIC_API_URL=

# Discord OAuth2 client secret (Developer Portal → OAuth2 → Client Secret).
DISCORD_CLIENT_SECRET=

# LAN development only: set to true to skip Discord OAuth entirely.
# NEVER enable this while the tunnel is up.
AUTH_DISABLED=false

# Comma-separated Discord user ids that may delete anyone's clips.
ADMIN_USER_IDS=

# Where clips + the SQLite DB are stored (default: ./data).
DATA_DIR=

# ── Spotify jukebox (web app search + playback controls) ─────────────
# Create an app at https://developer.spotify.com/dashboard and add
# <PUBLIC_API_URL>/api/spotify/callback as a Redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: librespot cache dir holding credentials.json from the
# one-time `librespot --enable-oauth` login (default: <DATA_DIR>/librespot).
LIBRESPOT_CACHE_DIR=
