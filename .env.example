# ── Discord credentials ──────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from the "General Information" page
CLIENT_ID=your-application-id-here

# Optional: register commands to a single guild for instant availability
# during development. Leave blank to register commands globally
# (global registration can take up to an hour to propagate).
GUILD_ID=

# ── librespot configuration ──────────────────────────────────────────
# Absolute path to the librespot binary on the Raspberry Pi.
LIBRESPOT_PATH=/usr/bin/librespot

# Name that appears in the Spotify Connect device list.
LIBRESPOT_DEVICE_NAME=DiscordBot

# Initial volume (0-100) passed to librespot.
LIBRESPOT_INITIAL_VOLUME=100
